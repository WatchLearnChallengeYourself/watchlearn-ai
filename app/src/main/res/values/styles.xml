<resources>
    <style name="Theme.WatchLearn" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/wl_cyan</item>
        <item name="android:statusBarColor">@color/wl_navy</item>
        <item name="android:navigationBarColor">@color/wl_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.WatchLearn.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wl_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_watchlearn_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WatchLearn</item>
    </style>
</resources>
